# ============================================================
# MANORA Backend - Environment Configuration
# ============================================================

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manora

# LLM / OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=openai/gpt-4o-mini

# ML Emotion Classifier
EMOTION_MODEL_NAME=distilbert-base-uncased-emotion

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_ENABLED=false

# Neo4j Graph DB
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_ENABLED=false

# Buddy State Configuration
BUDDY_DECAY_RATE=0.05

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Observability - Sentry (Leave blank to disable in local development)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Observability - Langfuse (Leave blank to disable in local development)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Observability - Prometheus
PROMETHEUS_ENABLED=true

